# Copy to .env and change before exposing the stack beyond your machine.
# Every value has a demo default in docker-compose.yml.

# Web sign-in for the first (admin) user.
GITAIHUB_ADMIN_USERNAME=pierre
GITAIHUB_ADMIN_PASSWORD=gitaihub-demo

# gitai's shared (operator) token, used by the API to read repositories.
GITAI_SHARED_TOKEN=demo-shared-token

# Agent tokens. GITAI_TOKEN_PIERRE is the admin's own gitai identity, used to
# post review comments and verdicts.
GITAI_TOKEN_PLANNER=demo-token-planner
GITAI_TOKEN_BUILDER=demo-token-builder
GITAI_TOKEN_REVIEWER=demo-token-reviewer
GITAI_TOKEN_DOCS_BOT=demo-token-docs-bot
GITAI_TOKEN_PIERRE=demo-token-pierre

POSTGRES_PASSWORD=gitaihub

# How often the demo seeder lands a heartbeat change. Empty: seed once, exit.
SEED_LIVE_INTERVAL=60s

# Set to true behind HTTPS (the tls profile).
GITAIHUB_COOKIE_SECURE=false
# GITAIHUB_DOMAIN=gitaihub.example.com
# GITAIHUB_WEB_PORT=3000
# LOG_LEVEL=info
